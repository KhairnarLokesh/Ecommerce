# Kalika Enterprises - Production & Shared Hosting .htaccess

# Disable directory browsing
Options -Indexes

# UTF-8 default encoding
AddDefaultCharset UTF-8

# Protect sensitive directories and hidden files
<IfModule mod_authz_core.c>
    <FilesMatch "^\.|\.(md|sql|log|sample\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|\.(md|sql|log|sample\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Block direct web access to sensitive folders
RewriteEngine On

# Redirect to HTTPS in production (if header or server port is HTTP)
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block direct access to internal folders if docroot is workspace root
RewriteRule ^(config|includes|database|docs|logs)/ - [F,L,NC]

# Global HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

