# Secure Uploads Root Directory - Kalika Enterprises
# Prevent direct directory listing
Options -Indexes

# Disable PHP script execution in uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|bash|exe|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow only standard static media
<FilesMatch "(?i)\.(jpg|jpeg|png|webp|gif|svg|pdf)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

# Remove script handlers
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
